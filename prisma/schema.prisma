generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum StaffRole {
  ADMIN
  SUB_ADMIN
  COORDINATOR
}

enum InviteStatus {
  PENDING // imported from CSV, email not sent yet
  INVITED // invitation email sent
  REGISTERED // alumni completed registration
  BOUNCED // email delivery failed
}

enum BatchStatus {
  PROCESSING
  UPLOADED
  INVITED
  COMPLETED
  PARTIAL_FAILED
}

enum RsvpStatus {
  ATTENDING
  NOT_ATTENDING
  MAYBE
}

enum EmailType {
  INVITATION
  EVENT_ANNOUNCEMENT
  EVENT_REMINDER
  REGISTRATION_CONFIRMATION
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
  BOUNCED
}

// Alumni Open Login
enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum JobCategory {
  VACANCY
  ACTIVE_DRIVE
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum NotificationCampaignStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationChannel {
  PUSH_AND_INAPP
  INAPP_ONLY
}

enum PushDeliveryStatus {
  SCHEDULED
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
  FAILED
}

enum NotificationType {
  ADMIN_ANNOUNCEMENT
  FOLLOW
  ANALYTICS_MILESTONE
  POST_CREATED
  COMMUNITY_UPDATE
}

// ─────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────
model Campus {
  id        String   @id @default(cuid())
  name      String   @unique   // e.g., "Main Campus Jalandhar", "Mohali Campus"
  code      String   @unique   // e.g., "main", "mohali", "amritsar", "hoshiarpur", "batala"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff   Staff[]
  alumni  Alumni[]

  registrationRequests RegistrationRequest[]
  communities          Community[]

  @@map("campuses")
}

model AffiliatedCollege {
  id          String   @id @default(cuid())
  name        String   @unique
  isApproved  Boolean  @default(false)
  requestedBy String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  alumni               Alumni[]
  registrationRequests RegistrationRequest[]

  @@map("affiliated_colleges")
}


model Staff {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         StaffRole @default(ADMIN)
  createdAt    DateTime  @default(now())

  // OTP fields for email verification
  otpHash      String?
  otpExpiresAt DateTime?
  isVerified   Boolean   @default(false)

  // Refresh tokens for JWT rotation
  refreshTokens StaffRefreshToken[]

  // Campus assignment – only for SUB_ADMIN (ADMIN has null)
  campusId     String?
  campus       Campus?   @relation(fields: [campusId], references: [id])

  // Module permissions (JSON array of strings, e.g., ["dashboard","alumni","import","events","jobs"])
  modules      Json?     @default("[]")

  // Who created this staff (admin user id)
  createdById  String?
  createdBy    Staff?    @relation("StaffCreator", fields: [createdById], references: [id])
  createdStaff Staff[]   @relation("StaffCreator")

  // Relations
  batches              InvitationBatch[]
  events               Event[]
  importedAlumni       Alumni[]
  reviewedRequests     RegistrationRequest[]
  jobs                 Job[]
  posts                Post[]
  albums               Album[]
  communityMemberships CommunityMember[]
  communityUpdates     CommunityUpdate[]
  communityBlogs       CommunityBlog[]
  notifications        Notification[]       @relation("NotificationCreator")

  @@index([campusId])
  @@map("staff")
}

model InvitationBatch {
  id          String      @id @default(cuid())
  label       String // e.g. "CSE Batch 2019"
  csvFilename String?
  totalCount  Int         @default(0)
  sentCount   Int         @default(0)
  failedCount Int         @default(0)
  status      BatchStatus @default(PROCESSING)
  createdById String
  createdBy   Staff       @relation(fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  completedAt DateTime?

  alumni Alumni[]

  @@map("invitation_batches")
}

model Alumni {
  id                   String       @id @default(cuid())
  name                 String
  email                String       @unique // current active email (can be updated)
  originalInvitedEmail String? // original email from CSV import
  enrollmentNo         String?
  batchYear            Int
  branch               String
  college              String
  course               String?
  phone                String?
  inviteToken          String?      @unique
  inviteStatus         InviteStatus @default(PENDING)
  isRegistered         Boolean      @default(false)

  // OAuth provider IDs
  googleId   String? @unique
  linkedinId String? @unique

  // Password for manual registration (only if registered manually)
  passwordHash String?

  resetTokenHash      String?
  resetTokenExpiresAt DateTime?

  // Alumni session refresh tokens (JWT rotation)
  alumniRefreshTokens AlumniRefreshToken[]

  // Profile fields (filled by alumni)
  currentRole    String?
  currentCompany String?
  city           String?
  linkedinUrl    String?
  avatarUrl      String?
  bio            String? @db.Text

  // Extra profile fields
  isActive       Boolean      @default(true)
  needsReview    Boolean      @default(false)
  dob            DateTime?
  gender         Gender?
  addressLine    String?
  pincode        String?
  country        String?
  locationId     String?
  location       PincodeLocation? @relation(fields: [locationId], references: [id])
  mapVisibility  MapVisibility    @default(PUBLIC)

  // Campus assignment – each alumni belongs to one campus
  campusId     String // alumni must belong to a campus (foreign key)
  campus       Campus   @relation(fields: [campusId], references: [id])

  // Affiliated College assignment (optional)
  affiliatedCollegeId String?
  affiliatedCollege   AffiliatedCollege? @relation(fields: [affiliatedCollegeId], references: [id])

  // Tracking
  importedById String?
  importedBy   Staff?           @relation(fields: [importedById], references: [id])
  batchId      String?
  batch        InvitationBatch? @relation(fields: [batchId], references: [id])
  invitedAt    DateTime?
  registeredAt DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime         @default(now())

  // Relations
  rsvps               Rsvp[]
  emailLogs           EmailLog[]
  education           Education[]
  workExperience      WorkExperience[]
  posts               Post[]
  likes               Like[]
  comments            Comment[]
  startups            StartUp[]
  albums              Album[]
  albumLikes          AlbumLike[]
  jobs                Job[]
  events              Event[]
  sentConnections     Connection[]     @relation("SentConnections")
  receivedConnections Connection[]     @relation("ReceivedConnections")
  communityMemberships CommunityMember[]
  communityUpdates     CommunityUpdate[]
  communityPollVotes   CommunityPollVote[]
  communityBlogs       CommunityBlog[]

  followersCount      Int              @default(0)
  followingCount      Int              @default(0)
  followers           AlumniFollow[]   @relation("AlumniFollowing")
  following           AlumniFollow[]   @relation("AlumniFollower")

  notificationsReadAt DateTime?
  pushSubscriptions   PushSubscription[]
  notifications       Notification[]      @relation("UserNotifications")
  notificationStates  NotificationState[] @relation("UserNotificationStates")

  @@index([batchYear])
  @@index([branch])
  @@index([college])
  @@index([course])
  @@index([inviteStatus])
  @@index([inviteToken])
  @@index([originalInvitedEmail])
  @@index([campusId])
  @@index([affiliatedCollegeId])
  @@index([isActive])
  @@index([city])
  @@index([pincode])
  @@index([name])
  @@index([currentCompany])
  @@index([currentRole])
  @@index([gender])
  @@index([locationId])
  @@map("alumni")
}

model Event {
  id            String    @id @default(cuid())
  title         String
  description   String @db.Text
  category      String    @default("General")
  eventDate     DateTime
  venue         String
  coverImageUrl String?
  imageUrls     Json?
  rsvpDeadline  DateTime?
  isPublished   Boolean   @default(false)
  showOnLanding Boolean   @default(false)

  postedByStaffId  String?
  postedByStaff    Staff?  @relation(fields: [postedByStaffId], references: [id])
  postedByAlumniId String?
  postedByAlumni   Alumni? @relation(fields: [postedByAlumniId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())

  rsvps     Rsvp[]
  emailLogs EmailLog[]

  @@index([postedByStaffId])
  @@index([postedByAlumniId])
  @@index([category])
  @@index([eventDate])
  @@map("events")
}

model Rsvp {
  id          String     @id @default(cuid())
  alumniId    String
  alumni      Alumni     @relation(fields: [alumniId], references: [id])
  eventId     String
  event       Event      @relation(fields: [eventId], references: [id])
  status      RsvpStatus
  message     String?
  respondedAt DateTime   @default(now())

  @@unique([alumniId, eventId]) // one RSVP per alumni per event
  @@index([eventId])
  @@map("rsvps")
}

model EmailLog {
  id             String      @id @default(cuid())
  recipientEmail String
  alumniId       String?
  alumni         Alumni?     @relation(fields: [alumniId], references: [id])
  eventId        String?
  event          Event?      @relation(fields: [eventId], references: [id])
  type           EmailType
  status         EmailStatus @default(QUEUED)
  brevoMessageId String? // ID returned by Brevo API for tracking
  errorMessage   String? @db.Text
  sentAt         DateTime    @default(now())

  @@index([recipientEmail])
  @@index([alumniId])
  @@map("email_logs")
}

// 2. Add the Registration Request Staging Model
model RegistrationRequest {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique // Prevents duplicate concurrent requests
  enrollmentNo String?
  idProffUrl    String? // college verification document url (e.g., student ID card)
  batchYear    Int
  branch       String
  college      String
  course       String?
  phone        String?
  campusId     String?
  campus       Campus?   @relation(fields: [campusId], references: [id])

  affiliatedCollegeId String?
  affiliatedCollege   AffiliatedCollege? @relation(fields: [affiliatedCollegeId], references: [id])

  // Professional Details
  currentRole    String?
  currentCompany String?
  linkedinUrl    String?

  // Extra Details for staging
  dob             DateTime?
  gender          Gender?
  addressLine     String?
  pincode         String?
  city            String?

  // Registration Type Tracking
  authProvider String // "GOOGLE", "LINKEDIN", or "MANUAL"
  providerId   String? // Stores googleId or linkedinId if applicable
  passwordHash String? // Stores hashed password if manual

  // Workflow Fields
  status          RequestStatus @default(PENDING)
  needsReview     Boolean       @default(false)
  rejectionReason String? @db.Text // Good UX so admins can state why they rejected

  // Admin Tracking Relations
  reviewedById String?
  reviewedBy   Staff?  @relation(fields: [reviewedById], references: [id])

  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
  @@index([affiliatedCollegeId])
  @@index([campusId])
  @@map("registration_requests")
}

// ─────────────────────────────────────────
// NEW MODELS FOR ALUMNI FEATURES
// ─────────────────────────────────────────

model Education {
  id           String    @id @default(cuid())
  alumniId     String
  alumni       Alumni    @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  school       String
  degree       String
  fieldOfStudy String?
  startDate    DateTime
  endDate      DateTime?
  isCurrent    Boolean   @default(false)
  description  String? @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([alumniId])
  @@map("education")
}

model WorkExperience {
  id          String    @id @default(cuid())
  alumniId    String
  alumni      Alumni    @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  company     String
  title       String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  description String? @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([alumniId])
  @@map("work_experiences")
}

model Post {
  id              String    @id @default(cuid())
  content         String? @db.Text
  images          PostImage[]
  authorId        String?
  author          Alumni?   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  postedByStaffId String?
  postedByStaff   Staff?    @relation(fields: [postedByStaffId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  likes    Like[]
  comments Comment[]

  @@index([authorId])
  @@index([postedByStaffId])
  @@map("posts")
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  alumniId  String
  alumni    Alumni   @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, alumniId])
  @@index([postId])
  @@index([alumniId])
  @@map("likes")
}

model Comment {
  id        String   @id @default(cuid())
  content   String @db.Text
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  alumniId  String
  alumni    Alumni   @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([alumniId])
  @@map("comments")
}

model StartUp {
  id          String   @id @default(cuid())
  name        String
  description String @db.Text
  websiteUrl  String?
  logoUrl     String?
  industry    String?
  foundedYear Int?
  founderId   String
  founder     Alumni   @relation(fields: [founderId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([founderId])
  @@map("startups")
}

model Album {
  id              String       @id @default(cuid())
  title           String
  description     String? @db.Text
  category        String       @default("College Days")
  alumniId        String?
  alumni          Alumni?      @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  postedByStaffId String?
  postedByStaff   Staff?       @relation(fields: [postedByStaffId], references: [id], onDelete: Cascade)
  images          AlbumImage[]
  likes           AlbumLike[]
  viewsCount      Int          @default(0)
  isPublished     Boolean      @default(false) // admin let it be published or not (public property scope to campus)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([alumniId])
  @@index([postedByStaffId])
  @@map("albums")
}

model AlbumImage {
  id        String   @id @default(cuid())
  albumId   String
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  imageUrl  String
  caption       String?
  showOnLanding Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([albumId])
  @@map("album_images")
}

model AlbumLike {
  id        String   @id @default(cuid())
  albumId   String
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  alumniId  String
  alumni    Alumni   @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([albumId, alumniId])
  @@index([albumId])
  @@index([alumniId])
  @@map("album_likes")
}

model Job {
  id              String      @id @default(cuid())
  title           String
  description     String @db.Text
  company         String
  location        String?
  category        JobCategory @default(VACANCY)
  salaryRange     String?
  applyUrl        String?
  isActive        Boolean     @default(true)
  postedByStaffId String?
  postedByStaff   Staff?      @relation(fields: [postedByStaffId], references: [id])
  postedByAlumniId String?
  postedByAlumni  Alumni?     @relation(fields: [postedByAlumniId], references: [id], onDelete: Cascade)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  expireAt        DateTime?   // job Expiry Date
  metadata        Json?       @default("{}")

  @@index([postedByStaffId])
  @@index([postedByAlumniId])
  @@index([category])
  @@index([isActive])
  @@map("jobs")
}

model Connection {
  id         String           @id @default(cuid())
  senderId   String
  sender     Alumni           @relation("SentConnections", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   Alumni           @relation("ReceivedConnections", fields: [receiverId], references: [id], onDelete: Cascade)
  status     ConnectionStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
  @@map("connections")
}

// ─────────────────────────────────────────
// NEW MODELS FOR LANDING PAGE MANAGEMENT
// ─────────────────────────────────────────

model LandingHeroSlide {
  id           String   @id @default(cuid())
  imageUrl     String
  headline     String?
  subtext      String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("landing_hero_slides")
}

model LandingStat {
  id           String   @id @default(cuid())
  number       String
  label        String
  icon         String
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("landing_stats")
}

model LandingWelcome {
  id          String   @id @default(cuid())
  title       String
  body        String @db.Text
  photo       String
  name        String
  designation String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("landing_welcomes")
}

model LandingNews {
  id            String   @id @default(cuid())
  title         String
  summary       String @db.Text
  body          String? @db.Text
  coverImage    String?
  category      String
  author        String
  publishedDate String
  campusTag     String
  linkTo        String?
  featured      Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("landing_news")
}

model LandingTestimonial {
  id           String   @id @default(cuid())
  name         String
  photo        String?
  batchYear    Int?
  branch       String?
  designation  String?
  company      String?
  quote        String @db.Text
  linkedIn     String?
  isSpotlight  Boolean  @default(false)
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("landing_testimonials")
}

model StaffRefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique @db.VarChar(255)
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([staffId])
  @@map("staff_refresh_tokens")
}

model AlumniRefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique @db.VarChar(255)
  alumniId  String
  alumni    Alumni   @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([alumniId])
  @@map("alumni_refresh_tokens")
}

model PostImage {
  id        String   @id @default(cuid())
  imageUrl  String   @db.Text
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([postId])
  @@map("post_images")
}

model LandingVideo {
  id           String   @id @default(cuid())
  videoUrl     String
  title        String
  description  String?  @db.Text
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("landing_videos")
}

enum LocationStatus {
  FOUND
  NOT_FOUND
}

enum MapVisibility {
  PUBLIC
  ALUMNI_ONLY
  HIDDEN
}

model PincodeLocation {
  id             String         @id @default(cuid())
  country        String
  pincode        String
  city           String?
  state          String?
  countryCode    String?
  displayName    String?        @db.Text
  latitude       Float?
  longitude      Float?
  status         LocationStatus @default(FOUND)
  source         String         @default("Nominatim")
  lastVerifiedAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  alumni Alumni[]

  @@unique([country, pincode])
  @@index([latitude, longitude])
}

model AcademicOption {
  id        String   @id @default(cuid())
  type      String   // 'BRANCH' | 'COURSE'
  value     String   // canonical display value
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, value])
  @@index([type])
  @@index([isActive])
  @@map("academic_options")
}

// ─────────────────────────────────────────
// COMMUNITY MODELS
// ─────────────────────────────────────────

enum CommunityRoleTag {
  LEADER
  COORDINATOR
  CORE_MEMBER
  ADVISOR
  MEMBER
  FOLLOWER
}

enum CommunityUpdateType {
  NEWSLETTER
  GENERAL_MSG
  PROGRESS_REPORT
  FUTURE_PLAN
  IDEA_SUGGESTION
}

model Community {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String   @db.Text
  logoUrl      String?
  bannerUrl    String?
  category     String   @default("General")

  campusId     String?
  campus       Campus?  @relation(fields: [campusId], references: [id])

  externalLinks Json?   @default("{}")

  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members      CommunityMember[]
  updates      CommunityUpdate[]
  blogs        CommunityBlog[]

  @@index([campusId])
  @@index([isActive])
  @@index([slug])
  @@map("communities")
}

model CommunityMember {
  id                    String           @id @default(cuid())
  communityId           String
  community             Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  
  alumniId              String?
  alumni                Alumni?          @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  staffId               String?
  staff                 Staff?           @relation(fields: [staffId], references: [id], onDelete: Cascade)

  roleTag               CommunityRoleTag @default(FOLLOWER)
  customTitle           String?          // e.g., "Faculty Advisor", "President"
  isFollowingNewsletter Boolean          @default(true)

  joinedAt              DateTime         @default(now())

  @@unique([communityId, alumniId])
  @@unique([communityId, staffId])
  @@index([communityId])
  @@index([alumniId])
  @@index([staffId])
  @@index([roleTag])
  @@map("community_members")
}

model CommunityUpdate {
  id              String              @id @default(cuid())
  communityId     String
  community       Community           @relation(fields: [communityId], references: [id], onDelete: Cascade)
  
  authorAlumniId  String?
  authorAlumni    Alumni?             @relation(fields: [authorAlumniId], references: [id], onDelete: SetNull)
  authorStaffId   String?
  authorStaff     Staff?              @relation(fields: [authorStaffId], references: [id], onDelete: SetNull)

  title           String
  content         String              @db.Text
  type            CommunityUpdateType @default(GENERAL_MSG)
  isNewsletter    Boolean             @default(false)
  isPinned        Boolean             @default(false)

  documents       CommunityDocument[]
  poll            CommunityPoll?

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([communityId])
  @@index([type])
  @@index([isNewsletter])
  @@map("community_updates")
}

model CommunityDocument {
  id          String          @id @default(cuid())
  updateId    String
  update      CommunityUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  fileUrl     String
  fileName    String
  fileSize    Int?
  mimeType    String?
  uploadedAt  DateTime        @default(now())

  @@index([updateId])
  @@map("community_documents")
}

model CommunityPoll {
  id            String                @id @default(cuid())
  updateId      String                @unique
  update        CommunityUpdate       @relation(fields: [updateId], references: [id], onDelete: Cascade)
  question      String
  allowMultiple Boolean               @default(false)
  expiresAt     DateTime?
  options       CommunityPollOption[]

  @@map("community_polls")
}

model CommunityPollOption {
  id        String              @id @default(cuid())
  pollId    String
  poll      CommunityPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text      String
  votes     CommunityPollVote[]

  @@index([pollId])
  @@map("community_poll_options")
}

model CommunityPollVote {
  id        String              @id @default(cuid())
  optionId  String
  option    CommunityPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  alumniId  String
  alumni    Alumni              @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  createdAt DateTime            @default(now())

  @@unique([optionId, alumniId])
  @@map("community_poll_votes")
}

model CommunityBlog {
  id              String    @id @default(cuid())
  communityId     String
  community       Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  
  slug            String
  title           String
  summary         String    @db.Text
  content         String    @db.Text
  coverImage      String?
  category        String    @default("Recap")
  tags            Json?     @default("[]")

  authorAlumniId  String?
  authorAlumni    Alumni?   @relation(fields: [authorAlumniId], references: [id], onDelete: SetNull)
  authorStaffId   String?
  authorStaff     Staff?    @relation(fields: [authorStaffId], references: [id], onDelete: SetNull)

  isPublished     Boolean   @default(false)
  publishedAt     DateTime?
  viewsCount      Int       @default(0)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([communityId, slug])
  @@index([communityId])
  @@index([isPublished])
  @@map("community_blogs")
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("newsletters")
}
model NormalizationMergeLog {
  id          String   @id @default(cuid())
  field       String   // 'college' | 'branch' | 'course'
  fromValues  String   @db.LongText // JSON array of original text values that were merged
  toValue     String
  affectedIds String   @db.LongText // JSON array of Alumni/RegistrationRequest ids that were updated
  performedBy String   // admin staff id or email
  createdAt   DateTime @default(now())

  @@index([field])
  @@index([createdAt])
  @@map("normalization_merge_logs")
}

model AlumniFollow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    Alumni   @relation("AlumniFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following   Alumni   @relation("AlumniFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("alumni_follows")
}

// ─────────────────────────────────────────
// SUPPORT DESK & PUBLIC RSVPS
// ─────────────────────────────────────────

enum TicketStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id           String       @id @default(cuid())
  ticketNo     String       @unique
  name         String
  email        String
  phone        String?
  enrollmentNo String?
  category     String       @default("General Support")
  subject      String
  message      String       @db.Text
  status       TicketStatus @default(PENDING)
  adminNotes   String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@map("support_tickets")
}

model EventRsvp {
  id        String   @id @default(cuid())
  eventId   String?
  eventName String
  name      String
  email     String
  phone     String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([email])
  @@map("event_rsvps")
}

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  user       Alumni   @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String   @unique @db.VarChar(500)
  p256dh     String   @db.Text
  auth       String   @db.Text
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @updatedAt

  @@index([userId])
  @@map("push_subscriptions")
}

model Notification {
  id             String               @id @default(cuid())
  type           NotificationType
  title          String
  body           String               @db.Text
  url            String?
  metadata       Json?
  audienceTag    String               @db.VarChar(500)
  targetUserId   String?
  targetUser     Alumni?              @relation("UserNotifications", fields: [targetUserId], references: [id], onDelete: Cascade)
  createdAt      DateTime             @default(now())

  // Merged push delivery tracking fields
  channel        NotificationChannel  @default(INAPP_ONLY)
  filter         Json?
  pushStatus     PushDeliveryStatus?
  pushCursor     String?
  totalTargets   Int?
  sentCount      Int                  @default(0)
  failedCount    Int                  @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  scheduledFor   DateTime?

  createdById    String?
  createdBy      Staff?               @relation("NotificationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  userStates     NotificationState[]

  // Grouping for fanned-out campaign notifications
  campaignGroupId String?

  @@index([audienceTag])
  @@index([createdAt])
  @@index([targetUserId])
  @@index([pushStatus])
  @@index([campaignGroupId])
  @@index([scheduledFor])
  @@map("notifications")
}

model NotificationState {
  id             String       @id @default(cuid())
  userId         String
  user           Alumni       @relation("UserNotificationStates", fields: [userId], references: [id], onDelete: Cascade)
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  isRead         Boolean      @default(false)
  isDeleted      Boolean      @default(false)
  updatedAt      DateTime     @updatedAt

  @@unique([userId, notificationId])
  @@index([userId])
  @@map("notification_states")
}




